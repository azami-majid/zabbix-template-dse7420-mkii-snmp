          type: SNMP_AGENT
          snmp_oid: 1.3.6.1.4.1.41385.1.4.1.2.1.2.1
          key: dse.generator.frequency
          delay: 30s
          history: 90d
          trends: 365d
          value_type: FLOAT
          units: Hz
          preprocessing:
            - type: MULTIPLIER
              parameters:
                - '0.1'
          triggers:
            - uuid: 9e5d0c8c5a6d4e6d8a0b2c3d4e5f6505
              expression: 'last(/Template DSE7420 MKII SNMP/dse.engine.speed.display)>{$DSE.ENG.SPEED.MIN} and last(/Template DSE7420 MKII SNMP/dse.generator.frequency)<{$DSE.GEN.FREQ.MIN}'
              name: 'DSE7420 MKII: engine running but generator frequency low'
              priority: AVERAGE
            - uuid: 9e5d0c8c5a6d4e6d8a0b2c3d4e5f6506
              expression: 'last(/Template DSE7420 MKII SNMP/dse.generator.frequency)>{$DSE.GEN.FREQ.MAX}'
              name: 'DSE7420 MKII: generator frequency high'
              priority: AVERAGE

        - uuid: 9e5d0c8c5a6d4e6d8a0b2c3d4e5f6303
          name: Generator L1 voltage
          type: SNMP_AGENT
          snmp_oid: 1.3.6.1.4.1.41385.1.4.1.2.1.3.1
