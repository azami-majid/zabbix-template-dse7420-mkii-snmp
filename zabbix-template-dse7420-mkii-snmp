zabbix_export:
  version: '7.4'
  template_groups:
    - uuid: 9e5d0c8c5a6d4e6d8a0b2c3d4e5f6001
      name: Templates/Power

  templates:
    - uuid: 9e5d0c8c5a6d4e6d8a0b2c3d4e5f6002
      template: Template DSE7420 MKII SNMP
      name: Template DSE7420 MKII SNMP
      description: DSE7420 MKII monitoring by SNMP v2c for Generator and Engine with dashboard.
      groups:
        - name: Templates/Power
      macros:
        - macro: '{$SNMP_COMMUNITY}'
          value: CHANGE_ME
        - macro: '{$DSE.NODATA}'
          value: 10m
        - macro: '{$DSE.BATT.MIN}'
          value: '24'
        - macro: '{$DSE.BATT.MAX}'
          value: '30'
        - macro: '{$DSE.ENG.SPEED.MIN}'
          value: '500'
        - macro: '{$DSE.ENG.SPEED.MAX}'
          value: '1800'
        - macro: '{$DSE.GEN.FREQ.MIN}'
          value: '49'
        - macro: '{$DSE.GEN.FREQ.MAX}'
          value: '51'
        - macro: '{$DSE.GEN.VOLT.MIN}'
          value: '210'
        - macro: '{$DSE.GEN.VOLT.MAX}'
          value: '250'

      items:
        - uuid: 9e5d0c8c5a6d4e6d8a0b2c3d4e5f6101
          name: System description
          type: SNMP_AGENT
          snmp_oid: 1.3.6.1.2.1.1.1.0
          key: dse.sysDescr
          delay: 5m
          history: 90d
          value_type: CHAR
          trends: '0'

        - uuid: 9e5d0c8c5a6d4e6d8a0b2c3d4e5f6102
          name: System name
          type: SNMP_AGENT
          snmp_oid: 1.3.6.1.2.1.1.5.0
          key: dse.sysName
          delay: 5m
          history: 90d
          value_type: CHAR
          trends: '0'

        - uuid: 9e5d0c8c5a6d4e6d8a0b2c3d4e5f6103
          name: System uptime
          type: SNMP_AGENT
          snmp_oid: 1.3.6.1.2.1.1.3.0
          key: dse.sysUpTime
          delay: 1m
          history: 90d
          units: uptime

        - uuid: 9e5d0c8c5a6d4e6d8a0b2c3d4e5f6201
          name: Engine key ID
          type: SNMP_AGENT
          snmp_oid: 1.3.6.1.4.1.41385.1.4.1.3.1.1.1
          key: dse.engine.keyid
          delay: 5m
          history: 90d
          value_type: UNSIGNED

        - uuid: 9e5d0c8c5a6d4e6d8a0b2c3d4e5f6202
          name: Engine battery voltage
          type: SNMP_AGENT
          snmp_oid: 1.3.6.1.4.1.41385.1.4.1.3.1.7.1
          key: dse.engine.battery.voltage
          delay: 30s
          history: 90d
          trends: 365d
          value_type: FLOAT
          units: V
          preprocessing:
            - type: MULTIPLIER
              parameters:
                - '0.1'
          triggers:
            - uuid: 9e5d0c8c5a6d4e6d8a0b2c3d4e5f6501
              expression: 'nodata(/Template DSE7420 MKII SNMP/dse.engine.battery.voltage,{$DSE.NODATA})=1'
              name: 'DSE7420 MKII: no battery voltage data received'
              priority: HIGH
            - uuid: 9e5d0c8c5a6d4e6d8a0b2c3d4e5f6502
              expression: 'last(/Template DSE7420 MKII SNMP/dse.engine.battery.voltage)<{$DSE.BATT.MIN}'
              name: 'DSE7420 MKII: battery voltage low'
              priority: AVERAGE
            - uuid: 9e5d0c8c5a6d4e6d8a0b2c3d4e5f6503
              expression: 'last(/Template DSE7420 MKII SNMP/dse.engine.battery.voltage)>{$DSE.BATT.MAX}'
              name: 'DSE7420 MKII: battery voltage high'
              priority: WARNING

        - uuid: 9e5d0c8c5a6d4e6d8a0b2c3d4e5f6203
          name: Engine speed display
          type: SNMP_AGENT
          snmp_oid: 1.3.6.1.4.1.41385.1.4.1.3.1.8.1
          key: dse.engine.speed.display
          delay: 30s
          history: 90d
          trends: 365d
          value_type: FLOAT
          units: rpm
          triggers:
            - uuid: 9e5d0c8c5a6d4e6d8a0b2c3d4e5f6504
              expression: 'last(/Template DSE7420 MKII SNMP/dse.engine.speed.display)>{$DSE.ENG.SPEED.MAX}'
              name: 'DSE7420 MKII: engine speed high'
              priority: AVERAGE

        - uuid: 9e5d0c8c5a6d4e6d8a0b2c3d4e5f6204
          name: Engine module oil pressure raw
          type: SNMP_AGENT
          snmp_oid: 1.3.6.1.4.1.41385.1.4.1.3.1.87.1
          key: dse.engine.module.oil.pressure.raw
          delay: 30s
          history: 90d
          value_type: CHAR
          trends: '0'

        - uuid: 9e5d0c8c5a6d4e6d8a0b2c3d4e5f6205
