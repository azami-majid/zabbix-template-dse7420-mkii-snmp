        - uuid: 9e5d0c8c5a6d4e6d8a0b2c3d4e5f6301
          name: Generator key ID
          type: SNMP_AGENT
          snmp_oid: 1.3.6.1.4.1.41385.1.4.1.2.1.1.1
          key: dse.generator.keyid
